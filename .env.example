# Copia este archivo a `.env` (o exporta las variables directamente en tu shell)
# y completa los valores reales. No commitees el `.env` con credenciales reales.

# Credenciales de Jira para una instancia. El prefijo (aquí "PROJ") debe
# coincidir con el prefijo del ticket que le pases a `autopilot work`
# (ej. ticket "PROJ-123" busca JIRA_PROJ_URL/EMAIL/TOKEN).
JIRA_PROJ_URL=https://tu-dominio.atlassian.net
JIRA_PROJ_EMAIL=tu@email.com
JIRA_PROJ_TOKEN=tu-api-token

# Podés definir tantas instancias como necesites repitiendo el bloque
# anterior con otro prefijo:
# JIRA_OTRAINSTANCIA_URL=...
# JIRA_OTRAINSTANCIA_EMAIL=...
# JIRA_OTRAINSTANCIA_TOKEN=...

# Overrides opcionales de config (ver ~/.autopilot.yaml)
# AUTOPILOT_TIMEOUT_SECONDS=300
# AUTOPILOT_MAX_RETRIES=3
# AUTOPILOT_VERBOSITY=normal
